# ── Abdul Rehman Portfolio — environment template ──────────────────────────
# Copy to .env and fill in real values. NEVER commit a filled-in .env.

# Public site URL (no trailing slash). Used for canonical URLs, sitemap,
# robots.txt and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

# Resend API key — powers the contact form email delivery.
# Get one free at https://resend.com/api-keys
RESEND_API_KEY=

# PostgreSQL connection string (Prisma datasource).
# Example: postgresql://user:password@host:5432/portfolio?schema=public
DATABASE_URL=

# Google Analytics 4 measurement ID (optional). Leave empty to disable.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
